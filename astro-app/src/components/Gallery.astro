---
import GallerySlider from '@/components/react/GallerySlider';
import { Button } from '@/components/ui/button';
import { getAllArtworks } from '@/utils/sanity';
import { urlFor } from '@/utils/image';

const artworks = await getAllArtworks();
const galleryImages = artworks.map(artwork => ({
  id: artwork._id,
  src: urlFor(artwork.image).url(),
  alt: artwork.title,
  title: artwork.title,
  artist: artwork.artist ? `${artwork.artist.name} ${artwork.artist.surname}` : undefined
}));
---

<section id="gallery" class="relative w-full overflow-hidden py-20">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="font-title text-4xl mb-8 text-center opacity-0" data-animation="fadeInUp" data-delay="0.2">Our Latest Work</h2>
    <p class="text-xl text-center mb-8 max-w-2xl mx-auto opacity-0" data-animation="fadeIn" data-delay="0.4">
      Explore our portfolio of custom tattoos, each piece telling its own unique story through the art of Japanese tattooing.
    </p>
    <Button className="flex mx-auto mb-12 opacity-0" data-animation="fadeInScale" data-delay="0.6">
      <a href="/gallery">View Gallery</a>
    </Button>
  </div>
  <div class="relative opacity-0" data-animation="fadeInUp" data-delay="0.8">
    <GallerySlider client:load images={galleryImages} />
  </div>
</section>

<script>
  import { setupAnimations } from "@/utils/animations";

  setupAnimations(document.getElementById("gallery")! as HTMLElement);
</script>
