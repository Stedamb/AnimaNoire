---
import { getAllArtists } from '@/utils/sanity';
import ArtistsCarousel from '@/components/react/ArtistsCarousel';
import { Button } from '@/components/ui/button';

const artists = await getAllArtists();
---

<section id="artists" class="relative mx-auto grid max-w-[1600px] grid-cols-1 py-4 lg:grid-cols-3 lg:py-20">
  <div class="flex flex-col p-8">
    <h2 class="font-title text-5xl opacity-0" data-animation="fadeInUp" data-delay="0.2">I nostri artisti</h2>
    <p class="my-4 text-xl opacity-0" data-animation="fadeIn" data-delay="0.4">
      Abbiamo selezionato i migliori artisti per offrirti il migliore dei servizi. Ad ognuno il suo, ed in base alla tua richiesta ti affideremo al tatuatore che te la realizzerà al meglio.
    </p>
    <Button className="flex mx-auto lg:mr-auto lg:ml-0 mb-12 opacity-0" data-animation="fadeInScale" data-delay="0.6">
      <a href="/artisti">Tutti gli artisti</a>
    </Button>
  </div>
  <div class="flex lg:col-span-2 opacity-0" data-animation="fadeInLeft" data-delay="0.8">
    <ArtistsCarousel artists={artists} client:load />
  </div>
</section>

<script>
  import { setupAnimations } from "@/utils/animations";

  setupAnimations(document.getElementById("artists")! as HTMLElement);
</script>
