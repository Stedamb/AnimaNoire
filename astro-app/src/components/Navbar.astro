---
import { Button } from '@/components/ui/button';
import { MobileDrawer } from '@/components/react/MobileDrawer';
import { Phone } from 'lucide-astro';
import { routes } from '@/routes/routes';
---

<div class="absolute left-0 top-0 z-10 w-full">
  {/* Mobile Menu */}
  <MobileDrawer client:only />
  <a class="absolute right-6 top-6 md:hidden" href="/">
    <Phone size={32} />
  </a>

  {/* Desktop Menu */}
  <div class="hidden gap-4 p-6 md:flex">
    {
      routes.map((route) => (
        <Button variant="link" size="sm">
          <a class="text-2xl text-white" href={route.path}>
            {route.label}
          </a>
        </Button>
      ))
    }
    <Button variant="link" size="sm" className="ml-auto">
      <a class="text-2xl text-white" href="/">Prenota</a>
    </Button>
  </div>
</div>
