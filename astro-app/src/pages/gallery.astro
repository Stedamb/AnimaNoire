---
import Layout from '../layouts/Layout.astro';
import { GalleryGrid } from '@/components/react/GalleryGrid';
import { getAllGalleryImages } from '@/utils/sanity';

const artists = await getAllGalleryImages();
const images = artists.flatMap(artist => 
  (artist.galleryImages || []).map(img => ({
    ...img,
    artistName: `${artist.name} ${artist.surname}`
  }))
);

---

<Layout title="Gallery | Anima Noire Tattoo Atelier">
  <section
    id="gallery-header"
    class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-40 text-center"
  >
    <h2
      class="font-title text-balance text-5xl opacity-0"
      data-animation="fadeInUp"
    >
      Gallery
    </h2>
  </section>

  <section class="container mx-auto px-4 py-8">
    <GalleryGrid client:load images={images} />
  </section>
</Layout>

<script>
  import { setupAnimations } from "@/utils/animations";
  
  // Setup animations on initial load
  setupAnimations(document.body);

  // Re-run animations on client-side navigation
  document.addEventListener('astro:page-load', () => {
    setupAnimations(document.body);
  });
</script>
