---
import ReviewsCarousel from '@/components/react/ReviewsCarousel';
import { Button } from '@/components/ui/button';
---

<section class="relative w-full overflow-hidden py-20 bg-background/50">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="font-title text-4xl mb-8 text-center">What Our Clients Say</h2>
    <p class="text-xl text-center mb-8 max-w-2xl mx-auto">
      Read authentic reviews from our valued clients who have experienced the artistry and professionalism of AnimaNoire Tattoo Atelier.
    </p>
      <Button className="flex mx-auto mb-12">
        <a href="https://g.page/r/YOUR_GOOGLE_BUSINESS_ID/review" target="_blank" rel="noopener noreferrer">
          Leave a Review
        </a>
      </Button>
    <ReviewsCarousel client:load />
  </div>
</section>