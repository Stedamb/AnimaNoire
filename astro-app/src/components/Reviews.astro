---
import ReviewsCarousel from '@/components/react/ReviewsCarousel';
import { Button } from '@/components/ui/button';
---

<section id="reviews" class="relative w-full overflow-hidden py-20 bg-background/50">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-title text-5xl mb-8 text-center opacity-0" data-animation="fadeInUp" data-delay="0.2">La parola ai nostri clienti</h2>
    <p class="text-xl text-center mb-8 max-w-2xl mx-auto opacity-0" data-animation="fadeIn" data-delay="0.4">
      Leggi le recensioni Google dei nostri preziosi clienti che hanno vissuto l'arte e la professionalità di Anima Noire Tattoo Atelier.
    </p>
    <Button className="flex mx-auto mb-12 opacity-0" data-animation="fadeInScale" data-delay="0.6">
      <a href="https://search.google.com/local/writereview?placeid=ChIJ6Yv6eAXHLBMRSuHS98EPQoU" target="_blank" rel="noopener noreferrer">
        Lascia una recensione
      </a>
    </Button>
    <div class="opacity-0" data-animation="fadeInUp" data-delay="0.8">
      <ReviewsCarousel client:visible />
    </div>
  </div>
</section>

<script>
  import { setupAnimations } from "@/utils/animations";

  setupAnimations(document.getElementById("reviews")! as HTMLElement);
</script>