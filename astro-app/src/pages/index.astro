---
import Layout from '../layouts/Layout.astro';
import '@/styles/globals.css';
import { getPosts } from '../utils/sanity';
import Video from '@/components/Video.astro';
import { Button } from '@/components/ui/button';
import Artists from '@/components/Artists.astro';
import Loader from '@/components/Loader.astro';

const posts = await getPosts();
---

<Layout title="Welcome to Astro.">
  <Loader />
  <Video />

  <section
    class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-36 text-center lg:pb-36"
  >
    <h2 class="font-title text-balance text-5xl">AnimaNoire Tattoo Atelier</h2>
    <p class="my-4 text-xl">
      Welcome to the official website of AnimaNoire Tattoo Atelier, where we specialize in
      traditional Japanese tattooing techniques. We offer a unique and immersive experience for our
      clients, where they can experience the beauty and artistry of traditional Japanese tattooing.
    </p>
    <div class="mt-2 flex gap-4">
      <Button>
        <a class="rounded-md text-xl" href="/prenota">Prenota</a>
      </Button>
    </div>
  </section>

  <Artists />

  <!-- <section>
    {posts.length ? posts.map((post) => <Card post={post} />) : <Welcome />}
  </section> -->
</Layout>
