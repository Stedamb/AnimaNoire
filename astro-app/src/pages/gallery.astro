---
import Layout from '../layouts/Layout.astro';
import { GalleryGrid } from '@/components/react/GalleryGrid';
import { getAllGalleryImages } from '@/utils/sanity';
import { urlFor } from '@/utils/image';
import type { GalleryImage } from '@/utils/sanity';

const images = await getAllGalleryImages();
const galleryImages = images.map((image) => ({
  id: image.id,
  src: urlFor({ _ref: image.id }).width(1200).quality(80).url(),
  alt: image.alt || `${image.artist.name}'s work`,
  artist: `${image.artist.name} ${image.artist.surname}`
}));
---

<Layout title="Gallery | Anima Noire Tattoo Atelier">
  <section
    id="gallery-header"
    class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-40 text-center"
  >
    <h2
      class="font-title text-balance text-5xl opacity-0"
      data-animation="fadeInUp"
    >
      Gallery
    </h2>
  </section>

  <section class="container mx-auto px-4 py-8">
    <GalleryGrid client:load images={galleryImages} />
  </section>
</Layout>

<script>
  import { setupAnimations } from "@/utils/animations";

  setupAnimations(document.getElementById("gallery-header")! as HTMLElement);
</script>
