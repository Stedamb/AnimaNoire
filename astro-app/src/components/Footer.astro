---
import { Phone, Mail, Instagram, Facebook } from 'lucide-astro';
import { routes } from '@/routes/routes';
---

<div class="bg-muted">
  <div class="container-xl grid grid-cols-2 p-4 lg:grid-cols-3 lg:gap-8">
    <div class="col-span-2 p-8 mix-blend-exclusion lg:col-span-1">
      <img
        src="/logo.svg"
        alt="Logo"
        width="640"
        height="640"
        class="mx-auto h-auto w-1/2 lg:w-3/4"
      />
    </div>
    <div class="flex flex-col justify-center py-8 pl-8">
      <p class="text-2xl font-semibold">Anima Noire Tattoo Atelier</p>
      <div class="text-md mt-8">
        <a href="tel:+393202929963" class="flex items-start gap-2 underline">
          <Phone class="flex-shrink-0" size={18} />
          +39 320 292 9963
        </a>
        <a href="mailto:animanera.tattoo.studio@gmail.com" class="mt-2 flex items-start gap-2 underline">
          <Mail class="flex-shrink-0" size={18} />
          <span class="break-all">animanera.tattoo.studio@gmail.com</span>
        </a>
        <div class="mt-8">
          <p class="text-md">Follow us on social media:</p>
          <div class="mt-4 flex gap-4">
            <a
              href="https://www.facebook.com/animaneratattoostudio/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Facebook class="h-8 w-8" />
            </a>
            <a
              href="https://www.instagram.com/animanoire_tattoo_atelier/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Instagram class="h-8 w-8" />
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="flex flex-col items-end p-8 lg:items-start lg:justify-center">
      <div class="flex grow flex-col justify-between">
        {
          routes.map((item) => (
            <a 
              href={item.path} 
              class="font-title text-4xl hover:text-muted-foreground"
              onclick={`event.preventDefault(); ${
                item.path === '/' ? 
                'if(window.location.pathname === "/") { window.scrollTo({ top: 0, behavior: "smooth" }); } else { window.location.href = "/"; }' :
                'window.location.href = "' + item.path + '";'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>
