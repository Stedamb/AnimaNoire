---
import { getPosts } from '@/utils/sanity';
import ArtistsCarousel from '@/components/react/ArtistsCarousel';
import { Button } from '@/components/ui/button';

const posts = await getPosts();
---

<section class="relative mx-auto grid max-w-[1600px] grid-cols-1 py-4 lg:grid-cols-3 lg:py-20">
  <div class="flex flex-col p-8">
    <h2 class="font-title text-5xl">I nostri artisti</h2>
    <p class="my-4 text-xl">
      Siamo un team di artisti talentosi e creativi specializzati nella tradizione del tattoo.
      Offriamo un'esperienza unica e immersiva per i nostri clienti, dove possono esprimere la loro
      creatività e la loro passione per il tattoo.
    </p>
    <Button className="flex mx-auto lg:mr-auto lg:ml-0 mb-12">
      <a href="/gallery">Tutti gli artisti</a>
    </Button>
  </div>
  <div class="flex lg:col-span-2">
    <ArtistsCarousel posts={posts} client:load />
  </div>
</section>
