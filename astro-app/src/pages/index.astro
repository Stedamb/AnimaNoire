---
import Layout from '../layouts/Layout.astro';
import Video from '@/components/Video.astro';
import { Button } from '@/components/ui/button';
import Artists from '@/components/Artists.astro';
import Merch from '@/components/Merch.astro';
import Gallery from '@/components/Gallery.astro';
import Reviews from '@/components/Reviews.astro';
import Loader from '@/components/Loader.astro';
---

<Layout title="Home | AnimaNoire Tattoo Atelier">
  <Loader />
  <Video />

  <section id="introduction"
    class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-36 text-center lg:pb-36"
  >
    <h2 class="font-title text-balance text-5xl opacity-0" data-animation="fadeInUp" data-delay="0.2">AnimaNoire Tattoo Atelier</h2>
    <p class="my-4 text-xl opacity-0" data-animation="fadeIn" data-delay="0.4">
      Benvenuti nel sito ufficiale di AnimaNoire Tattoo Atelier. Il nostro studio unisce arte e passione 
      per creare tatuaggi unici e personali. Offriamo un'esperienza immersiva dove ogni dettaglio è 
      curato per trasformare le tue idee in arte sulla pelle.
    </p>
    <div class="mt-2 flex gap-4 opacity-0" data-animation="fadeInScale" data-delay="0.6">
      <Button>
        <a href="/prenota">Prenota</a>
      </Button>
    </div>
  </section>

  <Artists />
  <!-- <Merch /> -->
  <Reviews />
  <Gallery />
</Layout>

<script>
  import { setupAnimations } from "@/utils/animations";

  // Setup animations on initial load
  setupAnimations(document.body);

  // Re-run animations on client-side navigation
  document.addEventListener('astro:page-load', () => {
    setupAnimations(document.body);
  });
</script>
