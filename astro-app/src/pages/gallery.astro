---
import Layout from '../layouts/Layout.astro';
import { GalleryGrid } from '@/components/react/GalleryGrid';
import { getAllGalleryImages } from '@/utils/sanity';

const galleryImages = await getAllGalleryImages();
---

<Layout title="Gallery | AnimaNoire Tattoo Atelier">
  <section
    id="gallery-header"
    class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-40 text-center"
  >
    <h2
      class="font-title text-balance text-5xl opacity-0"
      data-animation="fadeInUp"
    >
      Gallery
    </h2>
  </section>

  <section id="gallery" class="relative px-4 bg-gradient-to-b from-background to-muted pb-20">
    <GalleryGrid client:load images={galleryImages} />
  </section>
</Layout>

<script>
  import { setupAnimations } from "@/utils/animations";

  setupAnimations(document.getElementById("gallery-header")! as HTMLElement);
</script>
