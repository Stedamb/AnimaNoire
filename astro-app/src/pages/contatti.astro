---
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/ui/button';

const mapUrl = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2862.9857601297713!2d12.461625576485792!3d44.14553827108305!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x132cc70578fa8be9%3A0x85420fc1f7d2e14a!2sAnima%20Noire%20Tattoo%20Atelier!5e0!3m2!1sit!2sit!4v1735584174687!5m2!1sit!2sit`;
---

<Layout
  title="Contatti | Anima Noire Tattoo Atelier"
  description="Contattaci per prenotare un appuntamento o per maggiori informazioni sul nostro studio di tatuaggi a Rimini"
>
  <section
    id="contatti"
    class="mx-4 mb-4 grid max-w-4xl grid-cols-1 pt-40 lg:mx-auto lg:mb-[25vh] lg:grid-cols-2"
  >
    <h1
      class="font-title text-center text-5xl opacity-0 lg:col-span-2"
      data-animation="fadeInUp"
      data-delay="0.1"
    >
      Contatti
    </h1>
    <div class="pt-8">
      <h2
        class="text-balance text-2xl font-bold opacity-0"
        data-animation="fadeInUp"
        data-delay="0.2"
      >
        Dove siamo
      </h2>
      <p class="my-4 text-xl opacity-0" data-animation="fadeIn" data-delay="0.3">
        Ci trovi a Bellaria Igea Marina, in via Torre 20a
      </p>
      <h2
        class="text-balance pt-4 text-2xl font-bold opacity-0"
        data-animation="fadeIn"
        data-delay="0.4"
      >
        Orari
      </h2>
      <ul class="my-4 text-xl opacity-0" data-animation="fadeIn" data-delay="0.5">
        <li><span class="font-semibold">Lunedì - Venerdì:</span> 09:30 - 12:00 / 16:00 - 22:30</li>
        <li><span class="font-semibold">Sabato:</span> 16:00 - 23:30</li>
        <li><span class="font-semibold">Domenica:</span> Chiuso</li>
      </ul>
      <h2
        class="text-balance pt-4 text-2xl font-bold opacity-0"
        data-animation="fadeIn"
        data-delay="0.6"
      >
        Contattaci
      </h2>
      <ul class="my-4 text-xl opacity-0" data-animation="fadeIn" data-delay="0.7">
        <li>
          <span class="font-medium">Email:</span>
          <a href="mailto:animanera.tattoo.studio@gmail.com" class="text-primary hover:underline">
            animanera.tattoo.studio@gmail.com
          </a>
        </li>
        <li>
          <span class="font-medium">Telefono:</span>
          <a href="tel:+393202929963" class="text-primary hover:underline"> +39 320 292 9963 </a>
        </li>
      </ul>
      <div class="pt-4 opacity-0" data-animation="fadeIn" data-delay="0.8">
        <Button>
          <a href="https://wa.me/393202929963" class="inline-block"> Prenota un Appuntamento </a>
        </Button>
      </div>
    </div>
    <div
      class="mt-8 h-[450px] overflow-hidden rounded-lg bg-gray-100 opacity-0"
      data-animation="fadeIn"
      data-delay="0.9"
    >
      <iframe
        src={mapUrl}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      >
      </iframe>
    </div>
  </section>
</Layout>

<script>
  import { setupAnimations } from '@/utils/animations';

  // Setup animations on initial load
  setupAnimations(document.body);

  // Re-run animations on client-side navigation
  document.addEventListener('astro:page-load', () => {
    setupAnimations(document.body);
  });
</script>
